<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen Theme (Android 12+) -->
    <style name="Theme.NichiHab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.NichiHab</item>
    </style>

    <style name="Theme.NichiHab" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
