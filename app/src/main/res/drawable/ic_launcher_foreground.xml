<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Final refined layer-list for the icon -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Logo with a specific size and center gravity -->
    <!-- 58dp is a safe size to ensure no cropping on any device launcher shape -->
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center"
        android:width="58dp"
        android:height="58dp" />
</layer-list>
